{
  "manifest_version": 2,
  "name": "Jile V5 approved sites",
  "version": "1.3",
  "browser_specific_settings": {"gecko": {"id": "approved-sites@jile-v5.local"}},
  "permissions": ["geckoViewAddons", "nativeMessaging", "nativeMessagingFromContent", "webRequest", "webRequestBlocking", "<all_urls>"],
  "background": {"scripts": ["policy.js"]},
  "content_scripts": [{"matches": ["https://*/*"], "js": ["login-fill.js"], "run_at": "document_idle"}]
}
